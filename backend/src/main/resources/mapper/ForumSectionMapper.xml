<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.demo.mapper.ForumSectionMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.project.demo.entity.ForumSection">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="icon" column="icon"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="postCount" column="post_count"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 查询所有启用的板块（按排序字段升序） -->
    <select id="selectAllEnabled" resultMap="BaseResultMap">
        SELECT id, name, description, icon, sort_order, post_count, status, create_time, update_time
        FROM forum_section
        WHERE status = 1
        ORDER BY sort_order ASC
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT id, name, description, icon, sort_order, post_count, status, create_time, update_time
        FROM forum_section
        WHERE id = #{id}
    </select>

    <!-- 增加/减少帖子数量 -->
    <update id="incPostCount">
        UPDATE forum_section
        SET post_count = post_count + #{delta}
        WHERE id = #{id}
    </update>

</mapper>